// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model House {
  id        Int      @id @default(autoincrement())
  address   String
  createdAt DateTime @default(now())

  completedWorks CompletedWork[]
  acts           Act[]
  annualReports  AnnualReport[]
}

model Employee {
  id        Int      @id @default(autoincrement())
  fullName  String
  role      String
  phone     String
  maxUserId String?  @unique
  createdAt DateTime @default(now())

  completedWorks CompletedWork[]
}

// Persists MAX-bot conversation state across webhook requests, rather
// than holding it in process memory: that would silently break the
// moment the app runs as more than one instance, and would lose any
// in-progress dialog (choosing a house, entering a description, etc.)
// on every restart or deploy. Keyed by the MAX user id, until the entry
// is submitted or cancelled.
model MaxBotSession {
  maxUserId String   @id
  step      String
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model CompletedWork {
  id              Int       @id @default(autoincrement())
  houseId         Int
  employeeId      Int
  description     String
  descriptionOriginal String? // raw text as entered by the employee, before any ИИ clean-up — kept so the AI-edited description (above) never silently loses the original wording; null if ИИ was unavailable (ANTHROPIC_API_KEY not set) when the record was created, in which case `description` IS the original text
  location        String
  volume          String
  materials       String
  beforePhotoKey  String?
  beforePhotoType String?
  afterPhotoKey   String?
  afterPhotoType  String?
  costKopecks     Int?
  costSuggestedKopecks Int? // ИИ's cost estimate — a hint only, never auto-applied; office staff may copy it into costKopecks, which still requires the normal confirmation step
  costConfirmed   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  house    House    @relation(fields: [houseId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  actLineItem ActLineItem?
  annualReportMaintenanceItem AnnualReportMaintenanceItem?
  annualReportRepairItem      AnnualReportRepairItem?

  @@index([houseId])
  @@index([employeeId])
}

// "Акт приемки оказанных услуг и (или) выполненных работ" — the official
// form per приказ Минстроя №761/пр от 26.10.2015 (form unchanged by приказ
// №318/пр, which from 01.09.2026 only regulates the drafting/signing
// procedure and deadlines, not the form itself — see
// docs/regulatory/prikaz-761pr-akt-form.txt for the verbatim text this
// model and the print view are built from).
//
// status: "draft" (being assembled/edited) -> "ready" (all required fields
// present, printable/exportable, still editable) -> "signed" (director has
// recorded it as physically signed; kept for the record, no longer edited).
model Act {
  id        Int      @id @default(autoincrement())
  houseId   Int
  number    String? // "АКТ N ___"
  signCity  String   @default("д. Лаголово") // "г. ___" — where the act itself is executed/signed

  periodFrom DateTime
  periodTo   DateTime

  // "Заказчик" — the owner or council-chair party signing on behalf of the
  // homeowners (форма акта, преамбула).
  customerName      String? // ФИО
  customerBasis     String? // "действующего на основании ..." (решение общего собрания / доверенность, дата, номер)
  customerApartment String? // "являющегося собственником квартиры N ___" — filled when подписант is the council chair

  // "Договор" this act's works were performed under.
  agreementNumber String?
  agreementDate   DateTime?

  // "Исполнитель" — ООО «Л-Сити», represented by a specific person for
  // this act's signature block.
  contractorName        String  @default("ООО «Л-Сити»")
  contractorPersonName  String? // "должность, ФИО"
  contractorPersonRole  String?

  status   String    @default("draft")
  signedAt DateTime?

  // Denormalized sum of lineItems.totalCostKopecks, kept in sync by the
  // server actions that add/remove/edit line items — avoids recomputing it
  // on every read (the print page still recomputes and cross-checks it).
  totalKopecks Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  house     House         @relation(fields: [houseId], references: [id], onDelete: Restrict)
  lineItems ActLineItem[]
  changeLogEntries ActChangeLogEntry[]

  @@index([houseId])
}

// One row of the act's 5-column table. Normally created from a single
// confirmed CompletedWork entry (completedWorkId set) — the reliable,
// auditable case. workName/periodicity are seeded from that record but
// stay editable since the act's wording doesn't have to be identical to
// the internal work-log text; unit/unitCostKopecks are never auto-filled
// (CompletedWork doesn't capture a structured quantity+unit today), so they
// start empty and are tracked as "needs review" until someone fills them in.
model ActLineItem {
  id     Int @id @default(autoincrement())
  actId  Int

  completedWorkId Int? @unique

  workName   String // "Наименование вида работы (услуги)"
  periodicity String // "Периодичность/количественный показатель выполненной работы"
  unit             String? // "Единица измерения" — manual, null = needs review
  unitCostKopecks  Int? // "Стоимость / сметная стоимость ... за единицу" — manual, null = needs review

  // "Цена выполненной работы (оказанной услуги), в рублях" — must trace to
  // a costConfirmed CompletedWork; see addWorksToAct in acts.ts.
  totalCostKopecks Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  act           Act            @relation(fields: [actId], references: [id], onDelete: Cascade)
  completedWork CompletedWork? @relation(fields: [completedWorkId], references: [id], onDelete: SetNull)

  @@index([actId])
}

// Audit trail for manual edits to an act's cost-bearing fields, per the
// "не гадать / всё прослеживаемо" requirement — who changed what, from what
// value to what value, and when. Written by the server actions, never by
// the UI directly.
model ActChangeLogEntry {
  id        Int      @id @default(autoincrement())
  actId     Int
  field     String // e.g. "lineItem.unitCostKopecks", "lineItem.totalCostKopecks", "act.number"
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  act Act @relation(fields: [actId], references: [id], onDelete: Cascade)

  @@index([actId])
}

// "Отчёт о деятельности по управлению многоквартирным домом" — приказ
// Минстроя №728/пр от 20.11.2025 (Минюст №84362, вступил в силу 01.03.2026).
// Дословный текст формы и перечня обязательных сведений:
// docs/regulatory/prikaz-728pr-godovoy-otchet.md — оттуда взяты подписи
// полей ниже и в дочерних моделях; при печати сверяться с этим файлом, а не
// "по памяти".
//
// Система не ведёт отдельно план работ (только факт), учёт
// должников/претензий/исков и учёт начислений и платежей жителей — поэтому
// поля Разделов 3-5 и остатки по текущему ремонту в Разделе 2 заполняются
// вручную (см. соответствующие поля ниже), план в Разделе 1 по умолчанию
// равен факту. Классификация работы между Разделом 1 (содержание) и
// Разделом 2 (текущий ремонт) предлагается автоматически при сборке отчёта
// (см. classifyWork в actions/annual-reports.ts), но требует подтверждения
// по каждой строке (categoryConfirmed) — отчёт нельзя перевести в "ready",
// пока не все строки подтверждены, аналогично REQUIRED_HEADER_FIELDS у Act.
//
// status: "draft" -> "ready" -> "published" (дата публикации — publishedAt,
// это и есть "Дата размещения отчета" в шапке формы).
model AnnualReport {
  id      Int @id @default(autoincrement())
  houseId Int
  year    Int // "за ______ год"

  status      String    @default("draft")
  publishedAt DateTime?

  // Шапка формы — реквизиты компании подставляются значениями из самого
  // свежего другого отчёта при создании (чтобы не вводить заново для
  // каждого дома), но хранятся в каждом отчёте отдельно — это снимок на
  // момент публикации, как totalKopecks у Act.
  orgFullName      String? @default("ООО «Л-Сити»")
  receptionAddress String? // "адрес места приёма населения..."
  ogrnOrInn        String? // "ОГРН/ИНН"
  contactName      String? // "ФИО, должность" уполномоченного давать разъяснения
  contactPhone     String?
  contactEmail     String?
  totalAreaSqm     Float? // "Общая площадь жилых и нежилых помещений... м2"

  // Разделы 2 (остатки на ремонт) – 5 (начисления и поступления) не
  // отслеживаются системой (данных для них нет — ни в completed work, ни
  // где-либо ещё) и заполняются вручную бухгалтером уже в скачанном файле
  // отчёта, поэтому в базе не хранятся — см. печатную форму в
  // app/annual-reports/[id]/page.tsx.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  house            House                          @relation(fields: [houseId], references: [id], onDelete: Restrict)
  maintenanceItems AnnualReportMaintenanceItem[]
  repairItems      AnnualReportRepairItem[]

  @@unique([houseId, year])
  @@index([houseId])
}

// Раздел 1 — работы по содержанию общего имущества. planQuantity/planCost
// ("по перечню работ (услуг)") заполняются тем же значением, что и
// actualQuantity/actualCost ("выполнено") при создании строки, так как в
// системе нет отдельной сметы/плана — оба поля остаются независимо
// редактируемыми на случай, если Мария их позже разделит вручную.
model AnnualReportMaintenanceItem {
  id       Int @id @default(autoincrement())
  reportId Int

  completedWorkId Int? @unique

  workName         String // "Наименование работы (услуги)"
  unit             String? // "Единица измерения работы (услуги)"
  unitPriceKopecks Int? // "Цена (стоимость) единицы работы (услуги), руб."

  planQuantity    Float?
  planCostKopecks Int?

  actualQuantity    Float?
  actualCostKopecks Int?

  // Подтверждает, что строка верно отнесена к "содержанию" (не к текущему
  // ремонту) — см. комментарий на AnnualReport про статус "ready".
  categoryConfirmed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report        AnnualReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  completedWork CompletedWork? @relation(fields: [completedWorkId], references: [id], onDelete: SetNull)

  @@index([reportId])
}

// Раздел 2 — работы по текущему ремонту. actReference подставляется из
// связанного Act (если завершённая работа уже включена в акт с номером) —
// единственное поле этой модели, которое система может заполнить
// достоверно сама, без ввода вручную.
model AnnualReportRepairItem {
  id       Int @id @default(autoincrement())
  reportId Int

  completedWorkId Int? @unique

  workName       String // "Наименование работы"
  basis          String? // "Основание проведения работы"
  costKopecks    Int // "Стоимость работы по текущему ремонту..."
  volumeWithUnit String? // "Объем выполненных работ с единицами измерения"
  actReference   String? // "Реквизиты акта выполненных работ или адрес сайта..."

  categoryConfirmed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report        AnnualReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  completedWork CompletedWork? @relation(fields: [completedWorkId], references: [id], onDelete: SetNull)

  @@index([reportId])
}
