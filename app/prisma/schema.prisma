// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model House {
  id        Int      @id @default(autoincrement())
  address   String
  createdAt DateTime @default(now())

  completedWorks CompletedWork[]
}

model Employee {
  id        Int      @id @default(autoincrement())
  fullName  String
  role      String
  phone     String
  maxUserId String?  @unique
  createdAt DateTime @default(now())

  completedWorks CompletedWork[]
}

// Persists MAX-bot conversation state across webhook requests, rather
// than holding it in process memory: that would silently break the
// moment the app runs as more than one instance, and would lose any
// in-progress dialog (choosing a house, entering a description, etc.)
// on every restart or deploy. Keyed by the MAX user id, until the entry
// is submitted or cancelled.
model MaxBotSession {
  maxUserId String   @id
  step      String
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model CompletedWork {
  id              Int       @id @default(autoincrement())
  houseId         Int
  employeeId      Int
  description     String
  location        String
  volume          String
  materials       String
  beforePhotoKey  String?
  beforePhotoType String?
  afterPhotoKey   String?
  afterPhotoType  String?
  costKopecks     Int?
  costConfirmed   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  house    House    @relation(fields: [houseId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([houseId])
  @@index([employeeId])
}
